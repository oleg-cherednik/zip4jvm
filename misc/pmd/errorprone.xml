<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Custom ruleset"
        xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
        xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 http://pmd.sourceforge.net/ruleset_2_0_0.xsd">

    <description>
        https://docs.pmd-code.org/latest/pmd_rules_java_errorprone.html
    </description>

    <rule ref="category/java/errorprone.xml">
        <!-- exclude name="DataflowAnomalyAnalysis"/ -->
        <!-- exclude name="BeanMembersShouldSerialize"/ -->
        <exclude name="NullAssignment"/>
        <exclude name="TestClassWithoutTestCases"/>
        <exclude name="DetachedTestCase"/>
        <!-- New in PMD 7.26.0. It mis-detects this TestNG-only project as JUnit
             Jupiter and false-flags every TestNG annotation. Exclude until PMD
             reliably detects TestNG-only codebases. -->
        <exclude name="WrongTestAnnotation"/>
    </rule>
    <rule ref="category/java/errorprone.xml/AvoidDuplicateLiterals">
        <properties>
            <property name="skipAnnotations" value="true"/>
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/AssignmentInOperand">
        <properties>
            <property name="allowWhile" value="true"/>
        </properties>
    </rule>
    <!-- ExecutorService is closed via shutdown()/shutdownNow() (ExecutorService.close()
         only exists on JDK 19+, but this module targets Java 8). Teach the rule to
         recognise these as closing methods. -->
    <rule ref="category/java/errorprone.xml/CloseResource">
        <properties>
            <property name="closeTargets" value="shutdown,shutdownNow"/>
        </properties>
    </rule>
</ruleset>
